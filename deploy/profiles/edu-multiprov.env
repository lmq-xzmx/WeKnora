# ── 场景配置：多 IdP 演示（中科矩 + 教育 同时接入）────────────────────
#
# 用途：验证「一套 WeKnora 接入多个客户的 Casdoor」——
# 登录页出现两个按钮，可分别用两边的账号登录，落到各自的租户。
# 用法：./scripts/run-local.sh --profile edu-multiprov [--bg]
#
# 本文件在 .env 之后加载 → 这里的值优先。
#
# ⚠️ 这里的 client_id 是**占位**。要真跑通，需要在 Casdoor 里为每个客户
#    各建一个应用（redirect_uri 填本机回调地址），把真实 client_id/secret
#    填进来 —— 或者用环境变量注入（见文件末尾）。
#
# 机制说明（2026-11-09 改造）：
#   · OIDC_AUTH_PROVIDERS_JSON 是一个 JSON 数组，每项一个 IdP
#   · 每项字段缺失时继承 .env 里的单 provider 字段
#   · 登录页按 providers 渲染按钮；点某个按钮 → /auth/oidc/url?provider=<id>
#   · 回调从**签名过的 state** 取回 provider → 用对应 client_id 换 token
#   · 生产不配这个变量 → Providers 为空 → 登录页仍是一个按钮（用户无感）
#
# ⚠️ JSON 里的引号必须写成**单引号**：`KEY='[{"a":"b"}]'`
#    因为这个文件是被 shell `source` 的 —— 双引号会被 shell 当引号处理剥掉，
#    JSON 直接变成非法格式（踩过：{id:zkju,...} → 解析失败 → 静默回落到单 IdP）。

OIDC_AUTH_ENABLE=true

# 单引号包裹整个 JSON；JSON 内部用双引号
OIDC_AUTH_PROVIDERS_JSON='[{"id":"zkju","display_name":"中科矩账号","issuer_url":"http://36.212.140.68:3012","client_id":"6afaa316e54e775f5152"},{"id":"edu","display_name":"教育账号","issuer_url":"http://36.213.66.254:3012","client_id":"REPLACE_WITH_EDU_CLIENT_ID"}]'

# 方式 B（推荐，client_secret 不落盘）：从环境变量注入
# OIDC_AUTH_PROVIDERS_JSON=${EDU_MULTI_PROVIDERS_JSON}
#
# 导出示例（不落盘）：
#   export EDU_MULTI_PROVIDERS_JSON='[{"id":"zkju",...},{"id":"edu",...}]'
