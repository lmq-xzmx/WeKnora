# ── 场景配置：中科矩（企业信息化）────────────────────────────────────
#
# 用途：开发机上模拟「中科矩客户」接入这套 WeKnora。
# 用法：./scripts/run-local.sh --profile zkju [--bg]
#
# 本文件在 .env 之后加载 → 这里的值优先。
#
# 登录方式：单 IdP（中科矩的 Casdoor）—— 与生产同形态，登录页一个按钮。
# 要切到多 IdP（同时接多个客户）看 edu-multiprov.env。

# ── OIDC（单 IdP）────────────────────────────────────────────────────
OIDC_AUTH_ENABLE=true
OIDC_AUTH_ISSUER_URL=http://36.212.140.68:3012
OIDC_AUTH_PROVIDER_DISPLAY_NAME=中科矩账号
OIDC_AUTH_CLIENT_ID=6afaa316e54e775f5152
