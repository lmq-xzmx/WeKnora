# OpenDataLoader PDF hybrid backend (Docling). Pre-install deps so the
# container listens on :5002 immediately instead of pip install on every start.
#
# Default --no-ocr: digital PDFs already have a text layer; Docling layout/table
# still runs without EasyOCR (avoids libGL + heavy OCR stack in slim images).
# For scanned PDFs use builtin docreader OCR, MinerU, or override with
# ODL_HYBRID_EXTRA_ARGS="--force-ocr" (requires extra system/Python deps).
#
# Multi-stage build: install pip packages + build any C extensions in a
# full toolchain image, then copy only the venv + binaries into a slim
# runtime image to drop the final size by ~30% (no gcc / libpython-dev).
# syntax=docker/dockerfile:1.6
# Digest pinned for reproducibility
FROM python:3.10-slim-bookworm@sha256:5be5aaecb962a41567bc8041f1e9e3432cb085b037fe057f9a562630b2e4b370 AS builder

# 国内构建机直连 deb.debian.org 很慢（NAS 实测 35KB/s），可用构建参数切国内源
ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s@deb.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources; \
    fi

WORKDIR /app

# Toolchain for compiling any C-extension wheels (numpy, opencv-python-headless,
# Docling's transitive deps). Slim-bookworm ships Python.h + libssl-dev headers
# out of the box; only the build-essential trio is missing.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential gcc python3-dev \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /var/cache/apt/lists/*

# Runtime shared libs needed by OpenCV / Docling after build stage is dropped.
# Listed here once so the runtime stage COPYs them explicitly instead of relying
# on the builder's transitive deps leaking through the medium run.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsm6 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /var/cache/apt/lists/*

# Build into a venv so the runtime stage has no pip / setuptools / build tooling.
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
        -i https://mirrors.aliyun.com/pypi/simple/ \
    && /opt/venv/bin/pip install --no-cache-dir "opendataloader-pdf>=2.4.7" \
        # 运行时默认 --no-ocr，不需要 [hybrid] extra（它会拖入 easyocr→torch→nvidia-cudnn 近 1GB） \
        -i https://mirrors.aliyun.com/pypi/simple/


# Runtime: clean slim image, only the venv + needed libs (already installed
# in the builder layer above, the apt cache was wiped after install so this
# stage starts from the same base + has the libraries baked in via the
# builder's lower layer).
# Digest pinned for reproducibility
FROM python:3.10-slim-bookworm@sha256:5be5aaecb962a41567bc8041f1e9e3432cb085b037fe057f9a562630b2e4b370 AS runtime

# 国内构建机直连 deb.debian.org 很慢（NAS 实测 35KB/s），可用构建参数切国内源
ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s@deb.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources; \
    fi

# Re-install just the runtime libraries (cheap, no toolchain).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsm6 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /var/cache/apt/lists/*

# Copy the prebuilt venv from builder (no pip, no build tools, no caches).
COPY --from=builder /opt/venv /opt/venv

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ODL_HYBRID_EXTRA_ARGS="--no-ocr"

EXPOSE 5002

HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=120s \
    CMD curl -f http://localhost:5002/health || exit 1

# Use exec form so signals (SIGTERM) propagate to the python process — the
# bash -c wrapper would swallow them and break graceful shutdown.
CMD ["sh", "-c", "exec opendataloader-pdf-hybrid --host 0.0.0.0 --port 5002 ${ODL_HYBRID_EXTRA_ARGS}"]